{
  "name": "playwrightframework",
  "version": "1.0.0",
  "description": "Playwright Test Automation Framework for MM Manager Application",
  "main": "index.js",

  "scripts": {
    "pretest": "npm run clean:allure && npm run clean:auth",

    "test": "npm run clean:allure && playwright test",
    "test:headed": "npm run clean:allure && playwright test --headed",

    "test:chrome": "npm run clean:allure && playwright test --project=chromium",
    "test:firefox": "npm run clean:allure && playwright test --project=firefox",
    "test:webkit": "npm run clean:allure && playwright test --project=webkit",

    "test:all-browsers": "npm run clean:allure && playwright test --project=chromium --project=firefox --project=webkit",

    "test:smoke": "npm run clean:allure && playwright test --grep @smoke",
    "test:regression": "npm run clean:allure && playwright test --grep @regression",
    "test:negative": "npm run clean:allure && playwright test --grep @negative",
    "test:e2e": "npm run clean:allure && playwright test --grep @e2e",

    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",

    "report:full": "npm run clean:allure && playwright test && npm run report:generate && npm run report:open",

    "run:fresh": "npx rimraf allure-results allure-report test-results && playwright test && allure generate allure-results --clean -o allure-report && allure open allure-report",

    "clean:auth": "npx rimraf .auth",
    "clean:allure": "npx rimraf allure-results allure-report",
    "clean:reports": "npx rimraf test-results playwright-report allure-results allure-report",
    "clean:all": "npx rimraf test-results playwright-report allure-results allure-report .auth",

    "setup": "npm install && npx playwright install --with-deps",
    "setup:ci": "npm ci && npx playwright install --with-deps",

    "postinstall": "npx playwright install chromium"
  },

  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "e2e",
    "test-framework"
  ],

  "author": "Kolusu Murali Krishna",
  "license": "ISC",

  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.3",
    "allure-playwright": "^3.4.5",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.3",
    "typescript-eslint": "^8.50.0"
  },

  "dependencies": {
    "allure-commandline": "^2.36.0",
    "dotenv": "^17.2.3",
    "csv": "^6.4.1",
    "xlsx": "^0.18.5"
  }
}