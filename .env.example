# ===================================
# MM Manager Test Automation Configuration
# ===================================

# ===================================
# Application Configuration
# ===================================

# Base URL of the application to test
MMM_BASE_URL=https://mmmdemo.issi-software.com


# ===================================
# Admin User Credentials
# ===================================

MMM_ADMIN_USERNAME=admin
MMM_ADMIN_PASSWORD=issi@1234


# ===================================
# LDAP User Credentials
# ===================================

MMM_LDAP_USERNAME=kmkrishna
MMM_LDAP_PASSWORD=Gangamma@8


# ===================================
# Invalid Credentials
# ===================================

MMM_INVALID_USERNAME=invaliduser
MMM_INVALID_PASSWORD=invalidpassword

# ===================================
# Test Configuration
# ===================================

# Run tests in headless mode (true/false)
# false = see browser, true = no browser window
HEADLESS=false

# Enable debug mode (true/false)
# Prints detailed logs
DEBUG=false

# ===================================
# CI/CD Configuration (Optional)
# ===================================

# Set to 'true' when running in CI/CD
# CI=true

# ===================================
# Notes
# ===================================
# 
# 1. Copy this file to .env: cp .env.example .env
# 2. Update with your actual credentials
# 3. Never commit .env file to version control
# 4. .env is already in .gitignore
#
