# ===================================
# ISSI GMS Test Automation Configuration
# ===================================

# ===================================
# Application Configuration
# ===================================

# Base URL of the application to test
Base=https://mmmdemo.issi-software.com

# ===================================
# Staff User Credentials
# ===================================

# USERNAME=admin
# PASSWORD=issi@1234

APP_USERNAME=admin
APP_PASSWORD=issi@1234

# ===================================
# LDAP User Credentials
# ===================================

LDAP_USERNAME=kmkkrishna
LDAP_PASSWORD=kmk@1234

# ===================================
# Invalid Credentials
# ===================================

INVALID_USERNAME=invaliduser
INVALID_PASSWORD=invalidpassword

# ===================================
# Test Configuration
# ===================================

# Run tests in headless mode (true/false)
# false = see browser, true = no browser window
HEADLESS=false

# Enable debug mode (true/false)
# Prints detailed logs
DEBUG=false

# ===================================
# CI/CD Configuration (Optional)
# ===================================

# Set to 'true' when running in CI/CD
# CI=true

# ===================================
# Notes
# ===================================
# 
# 1. Copy this file to .env: cp .env.example .env
# 2. Update with your actual credentials
# 3. Never commit .env file to version control
# 4. .env is already in .gitignore
#
